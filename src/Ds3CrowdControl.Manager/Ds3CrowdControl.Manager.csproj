<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ds3CrowdControl.Core\Ds3CrowdControl.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <Target Name="BuildDs3Mod" BeforeTargets="BeforeBuild">
    <Exec Command="cargo build --release --manifest-path &quot;$(MSBuildProjectDirectory)\..\ds3mod\Cargo.toml&quot;" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\ds3mod\target\release\ds3mod.dll" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>
</Project>
