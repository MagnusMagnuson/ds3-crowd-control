<Window x:Class="Ds3CrowdControl.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS3 Crowd Control"
        Height="740"
        Width="1080"
        Background="#1E1E1E"
        Foreground="#F3F3F3">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="180" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.ColumnSpan="2" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Attach to Dark Souls III" Command="{Binding AttachCommand}" Padding="12,6" Margin="12,0,0,0" />
            <CheckBox DockPanel.Dock="Right"
                      Content="Focus game for item test"
                      IsChecked="{Binding FocusGameForItemTest}"
                      VerticalAlignment="Center"
                      Foreground="#F3F3F3"
                      ToolTip="When enabled, testing Use selected item brings Dark Souls III to the foreground so it polls the synthetic controller press." />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="16" />
        </DockPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Background="#252526" Foreground="#F3F3F3" BorderBrush="#3F3F46" />

        <DockPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,0">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,8,0" />
                <Button Content="Test" Command="{Binding TestCommand}" Padding="16,6" />
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Preset" FontSize="18" Margin="0,0,0,8" />
                    <TextBlock Text="Name" />
                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                    <CheckBox Content="Enabled" IsChecked="{Binding EditEnabled}" Margin="0,0,0,8" Foreground="#F3F3F3" />
                    <TextBlock Text="Cooldown seconds" />
                    <TextBox Text="{Binding EditCooldown, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                    <ItemsControl ItemsSource="{Binding Arguments}">
                        <ItemsControl.Resources>
                            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
                        </ItemsControl.Resources>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVisibility}}" />
                                    <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Foreground="#F3F3F3" Visibility="{Binding IsCheckBox, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Play offline. Test stays off until the mod reports an offline session with a loaded character. Twitch will call this same queue later." TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <ListBox Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0" ItemsSource="{Binding LogLines}" Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46" />
    </Grid>
</Window>
