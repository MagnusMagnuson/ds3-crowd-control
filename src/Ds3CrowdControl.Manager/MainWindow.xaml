<Window x:Class="Ds3CrowdControl.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS3 Crowd Control"
        Height="780"
        Width="1080"
        Background="#1E1E1E"
        Foreground="#F3F3F3">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F3F3" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Tab" Background="#252526" BorderBrush="#3F3F46" BorderThickness="1,1,1,0" Padding="18,7" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tab" Property="Background" Value="#3F3F46" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="{Binding Status}" TextWrapping="Wrap" FontSize="16" Margin="0,0,0,12" />

        <TabControl Grid.Row="1" Grid.ColumnSpan="2" Background="#1E1E1E" BorderBrush="#3F3F46" Padding="12">
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="640" HorizontalAlignment="Left" Width="640">
                        <TextBlock Text="Game" FontSize="18" Margin="0,0,0,8" Foreground="#F3F3F3" />
                        <Button Content="Attach to Dark Souls III" Command="{Binding AttachCommand}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <TextBlock Text="Twitch" FontSize="18" Margin="0,0,0,8" Foreground="#F3F3F3" />
                        <TextBlock Text="{Binding TwitchStatus}" Margin="0,0,0,8" Foreground="#F3F3F3" />
                        <Button Content="{Binding TwitchButtonText}" Command="{Binding ToggleTwitchCommand}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,16" />

                        <TextBlock Text="Effects" FontSize="18" Margin="0,0,0,8" Foreground="#F3F3F3" />
                        <CheckBox Content="Pause all effects" IsChecked="{Binding EffectsPaused}" />
                        <TextBlock Text="Waiting effects stay in the queue and run when you turn this off. Twitch redeems are hidden from viewers until then." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,12" Foreground="#F3F3F3" />
                        <TextBlock Text="Gap between effects (seconds)" Foreground="#F3F3F3" />
                        <TextBox Text="{Binding GapSeconds, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="The shortest time from one effect starting to the next. Effects wait their turn, and Test skips this. 0 means no gap." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,12" Foreground="#F3F3F3" />
                        <TextBlock Text="Waiting effects limit" Foreground="#F3F3F3" />
                        <TextBox Text="{Binding WaitingLimit, UpdateSourceTrigger=PropertyChanged}" Width="100" HorizontalAlignment="Left" Margin="0,4,0,0" />
                        <TextBlock Text="Redeems past this many waiting are refunded. 0 means no limit." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,16" Foreground="#F3F3F3" />

                        <CheckBox Content="Show developer tools" IsChecked="{Binding ShowDevTools}"
                                  ToolTip="Adds Dump player data and Watch item button to the Presets page." />
                        <CheckBox Content="Focus game for item test" IsChecked="{Binding FocusGameForItemTest}" Margin="0,8,0,0"
                                  Visibility="{Binding ShowDevTools, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="When enabled, testing Use selected item brings Dark Souls III to the foreground so it polls the synthetic controller press." />
                        <CheckBox Content="Use Twitch CLI test server" IsChecked="{Binding UseTwitchTestServer}" Margin="0,8,0,0"
                                  Visibility="{Binding ShowDevTools, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Listens to twitch event websocket start-server on this PC instead of Twitch. Not saved, so it is off the next time the manager starts." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Events">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <CheckBox Content="Sync Redeem, Bits and Gift subs" IsChecked="{Binding SyncTriggers}" />
                        <TextBlock Text="While ticked, a switch turns all three on or off for that event, and All on and All off change all three columns." TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Foreground="#F3F3F3" />
                    </StackPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8" TextElement.Foreground="#F3F3F3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="170" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Event" VerticalAlignment="Top" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Redeem (points)" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All on" Command="{Binding AllOnCommand}" CommandParameter="redeem" Padding="8,2" Margin="0,0,6,0" />
                                <Button Content="All off" Command="{Binding AllOffCommand}" CommandParameter="redeem" Padding="8,2" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Bits (exact amount)" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All on" Command="{Binding AllOnCommand}" CommandParameter="bits" Padding="8,2" Margin="0,0,6,0" />
                                <Button Content="All off" Command="{Binding AllOffCommand}" CommandParameter="bits" Padding="8,2" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="3">
                            <TextBlock Text="Gift subs (exact count)" Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="All on" Command="{Binding AllOnCommand}" CommandParameter="gift" Padding="8,2" Margin="0,0,6,0" />
                                <Button Content="All off" Command="{Binding AllOffCommand}" CommandParameter="gift" Padding="8,2" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Events}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="170" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Foreground="#F3F3F3" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Redeem}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Redeem}" Width="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Bits}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Text="{Binding BitsAmount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Bits}" Width="90" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Gift}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBox Text="{Binding GiftAmount, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding Gift}" Width="90" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <TabItem Header="Presets">
                <Grid TextElement.Foreground="#F3F3F3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ListBox ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset}" DisplayMemberPath="Name" Background="#252526" Foreground="#F3F3F3" BorderBrush="#3F3F46" />
                    <DockPanel Grid.Column="1" Margin="12,0,0,0">
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                            <Button Content="Save" Command="{Binding SaveCommand}" Padding="16,6" Margin="0,0,8,0" />
                            <Button Content="Test" Command="{Binding TestCommand}" Padding="16,6" />
                        </StackPanel>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Preset" FontSize="18" Margin="0,0,0,8" />
                                <TextBlock Text="Name" />
                                <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                <TextBlock Text="Cooldown seconds" />
                                <TextBox Text="{Binding EditCooldown, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" />
                                <ItemsControl ItemsSource="{Binding Arguments}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <TextBlock Text="{Binding Label}" Visibility="{Binding ShowsLabel, Converter={StaticResource BoolToVisibility}}" />
                                                <ComboBox ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex}" Margin="0,4,0,0" Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,0" Visibility="{Binding IsTextBox, Converter={StaticResource BoolToVisibility}}" />
                                                <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked}" Visibility="{Binding IsCheckBox, Converter={StaticResource BoolToVisibility}}" />
                                                <TextBlock Text="{Binding Hint}" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,0" Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Play offline. Test stays off until the mod reports an offline session." TextWrapping="Wrap" Opacity="0.75" Margin="0,8,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <ListBox Grid.Row="2" Margin="0,12,0,0" ItemsSource="{Binding LogLines}" Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46" />

        <DockPanel Grid.Row="2" Grid.Column="1" Margin="12,12,0,0">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="Clear queue" Command="{Binding ClearQueueCommand}" Padding="10,3" />
                <CheckBox DockPanel.Dock="Right" Content="Show queue" IsChecked="{Binding ShowQueue}" VerticalAlignment="Center" Margin="0,0,10,0"
                          ToolTip="Turn off if the player does not want to see what is coming." />
                <TextBlock Text="{Binding QueueHeader}" FontSize="14" VerticalAlignment="Center" />
            </DockPanel>
            <Grid>
                <TextBlock Text="Hidden" Opacity="0.75" Margin="4" Visibility="{Binding QueueHidden, Converter={StaticResource BoolToVisibility}}" />
                <ListBox ItemsSource="{Binding QueueRows}" Background="#252526" Foreground="#D4D4D4" BorderBrush="#3F3F46"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding ShowQueue, Converter={StaticResource BoolToVisibility}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Opacity="0.7" FontSize="11" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding Who, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding State, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
